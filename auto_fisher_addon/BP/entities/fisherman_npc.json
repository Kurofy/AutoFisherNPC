{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "custom:fisherman_npc",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "custom:is_fishing": {
          "type": "bool",
          "client_sync": true,
          "default": false
        }
      }
    },
    "component_groups": {
      "fishing_active": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "fishing_idle": {
        "minecraft:variant": {
          "value": 0
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "npc",
          "fisherman",
          "humanoid",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "entity_attack",
            "deals_damage": true,
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_sneaking",
                    "subject": "other",
                    "value": true
                  }
                ]
              }
            }
          },
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": true
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:equippable": {
        "slots": [
          {
            "slot": "slot.weapon.mainhand",
            "item": "minecraft:air"
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.give_rod",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "player",
                    "value": "player"
                  },
                  {
                    "test": "is_sneaking",
                    "subject": "player",
                    "value": true
                  },
                  {
                    "test": "has_equipment",
                    "subject": "player",
                    "domain": "hand",
                    "value": "minecraft:fishing_rod"
                  },
                  {
                    "test": "has_tag",
                    "subject": "self",
                    "operator": "!=",
                    "value": "has_rod"
                  }
                ]
              }
            }
          },
          {
            "interact_text": "action.interact.fisherman",
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "player",
                "value": "player"
              }
            }
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "fishing_idle"
          ]
        }
      },
      "custom:start_fishing": {
        "remove": {
          "component_groups": [
            "fishing_idle"
          ]
        },
        "add": {
          "component_groups": [
            "fishing_active"
          ]
        },
        "set_property": {
          "custom:is_fishing": true
        }
      },
      "custom:stop_fishing": {
        "remove": {
          "component_groups": [
            "fishing_active"
          ]
        },
        "add": {
          "component_groups": [
            "fishing_idle"
          ]
        },
        "set_property": {
          "custom:is_fishing": false
        }
      },
      "custom:catch_fish": {
        "play_sound": {
          "sound": "random.bowhit"
        }
      }
    }
  }
}
